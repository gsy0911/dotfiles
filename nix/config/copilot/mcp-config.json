{
  "mcpServers": {
    "fetch-mcp": {
      "type": "local",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "mcp-fetch-server@1.1.2"
      ]
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": ["@playwright/mcp@0.0.84"]
    },
    "figma": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": "npx",
      "args": ["chrome-devtools-mcp@1.12.0"]
    }
  }
}

