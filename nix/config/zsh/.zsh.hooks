set_title() { 
  printf '\033]0;%s\007' "$1" 
}

git_branch() {
  local b
  b=$(command git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
  [[ "$b" == "HEAD" ]] && return 1
  print -r -- "$b"
}

git_repo_path() {
  # Gitリポジトリ外なら失敗
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1

  repo_name="${repo_root##*/}"

  # ルートとの差分パス取得
  rel_path="${PWD#$repo_root}"

  if [ -z "$rel_path" ]; then
    # 直下
    printf "%s" "$repo_name"
  else
    # 先頭の / を削る
    rel_path="${rel_path#/}"
    printf "%s/%s" "$repo_name" "$rel_path"
  fi
}

update_title() {
  # local b=$(git_branch)
  local p=$(git_repo_path)
  set_title " $p "
  # if b=$(git_branch); then
  #   set_title " $p "
  # else
  #   # Git外ならディレクトリ名などにする（好みで）
  #   set_title " "
  # fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd update_title
# cdした時にも更新
add-zsh-hook chpwd  update_title

# herdr: space の sidebar に PR 番号 ($pr) を表示する。
# precmd 毎に git rev-parse (数十ms) だけ行い、ブランチが変わった時か
# TTL (HERDR_PR_TTL, 既定 300 秒) 経過時のみ gh を叩く report-pr.sh を裏で走らせる。
if [[ -n "$HERDR_WORKSPACE_ID" ]]; then
  zmodload zsh/datetime
  typeset -g _herdr_pr_key="" _herdr_pr_at=0
  herdr_report_pr() {
    local key
    key="$(command git rev-parse --show-toplevel --abbrev-ref HEAD 2>/dev/null)"
    if [[ "$key" == "$_herdr_pr_key" ]] && (( EPOCHSECONDS - _herdr_pr_at < ${HERDR_PR_TTL:-300} )); then
      return
    fi
    _herdr_pr_key="$key" _herdr_pr_at=$EPOCHSECONDS
    bash "$HOME/.config/herdr/scripts/report-pr.sh" "$HERDR_WORKSPACE_ID" "$PWD" &>/dev/null &!
  }
  add-zsh-hook precmd herdr_report_pr
fi
